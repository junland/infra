set -euo pipefail

msg() {
    printf ' >>> %s\n' "$1"
}

LOGFILE="${LOGFILE:-${VARIABLE:-/var/log/nginx/*.access.log}}"

mapfile -t LOG_FILES < <(compgen -G "$LOGFILE" || true)
if ((${#LOG_FILES[@]} == 0)); then
    msg "$LOGFILE does not exist or is not a file..."
    exit 1
fi

msg "Report as of $(date)"

coproc IP_COUNTS {
    awk 'NF { count[$1]++ } END { for (ip in count) print count[ip], ip }' "${LOG_FILES[@]}" | sort -nr
}
IP_COUNTS_PID_VALUE=$IP_COUNTS_PID

while read -r COUNT IP <&"${IP_COUNTS[0]}"; do
    msg "Seaching for $IP with $COUNT hit(s) on this server."
    whois -- "$IP" | awk '/OrgName:|OrgId:|Address:|City:|StateProv:|Country:|OrgTechName:|OrgAbuseEmail:/'
done

wait "$IP_COUNTS_PID_VALUE"

exit 0
