set -euo pipefail

msg() {
    echo " >>> $1"
}

SOURCE_BACKUP_DIR="/mnt/storage/backup"
REMOTE_USER="user"
REMOTE_SERVER="server"
REMOTE_BACKUP_DIR="/usb1/backup"

# Make sure the local backup directory exists and contains files.
if [ ! -d "$SOURCE_BACKUP_DIR" ]; then
    msg "Error: Source backup directory does not exist: $SOURCE_BACKUP_DIR"
    exit 1
fi

shopt -s nullglob
backup_files=("$SOURCE_BACKUP_DIR"/*)
if [ ${#backup_files[@]} -eq 0 ]; then
    msg "Error: Source backup directory is empty: $SOURCE_BACKUP_DIR"
    exit 1
fi

# Connect to the remote server, create the backup directory if needed, and upload files.
msg "Connecting to remote server and backing up files..."
sftp -B 262144 -b - -o BatchMode=yes "$REMOTE_USER@$REMOTE_SERVER" <<EOF
-mkdir $REMOTE_BACKUP_DIR
cd $REMOTE_BACKUP_DIR
put $SOURCE_BACKUP_DIR/* .
EOF
