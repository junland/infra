set -euo pipefail

msg() {
    echo " >>> $1"
}

BASE_MOUNTPOINT=/mnt/storage
BACKUP_DATE_TIMESTAMP=$(date +%m-%d-%Y-%s)
EXCLUDE_FLAGS=()
OUTPUT_DIR=${1:-}

# Check if first argument is not empty and is a directory.
if [ -z "$OUTPUT_DIR" ] || [ ! -d "$OUTPUT_DIR" ]; then
    echo "Usage: $0 <directory>"
    exit 1
fi

if [ ! -d "$BASE_MOUNTPOINT" ]; then
    echo "Error: base mount point does not exist: $BASE_MOUNTPOINT"
    exit 1
fi

# Check if pigz is installed.
if ! command -v pigz >/dev/null 2>&1; then
    echo "Error: pigz is not installed"
    exit 1
fi

msg "Generateing archive file..."

# Create exclusion flags from .skip_archive markers.
while IFS= read -r -d '' skip_marker; do
    if [[ "$skip_marker" == */* ]]; then
        EXCLUDE_FLAGS+=("--exclude=${skip_marker%/.skip_archive}")
    else
        EXCLUDE_FLAGS+=("--exclude=.")
    fi
done < <(find "$BASE_MOUNTPOINT" -type f -name .skip_archive -printf '%P\0')

# Create archive
BACKUP_FILE="$OUTPUT_DIR/backup-$BACKUP_DATE_TIMESTAMP.tgz"
tar "${EXCLUDE_FLAGS[@]}" -I pigz -cvf "$BACKUP_FILE" -C "$BASE_MOUNTPOINT" .

msg "Created archive file: $BACKUP_FILE"
