---
# K3s configuration file generated by Ansible
write-kubeconfig-mode: "0644"
tls-san:
{% for san in k3s_tls_san_list | default([]) %}
  - "{{ san }}"
{% endfor %}
disable:
  - 'servicelb'  # Disable default servicelb to use HAProxy or MetalLB
  - 'traefik'    # Disable default traefik to use HAProxy
cluster-init: "{{ 'true' if k3s_install_exec == 'server' and inventory_hostname == groups['internal_servers'][0] else 'false' }}"
